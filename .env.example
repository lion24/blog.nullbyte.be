# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING"

# Google Tag Manager
GTM_ID="GTM-XXXXXXX"

# Redis (Upstash) for rate limiting (production only)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REDIS_REST_TOKEN"

# OpenAI for AI-generated editing
OPENAI_API_KEY="OPENAI_API_KEY"

# Created by Vercel CLI
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
SHADOW_DATABASE_URL="prisma+postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
POSTGRES_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PRISMA_DATABASE_URL="prisma+postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
VERCEL_OIDC_TOKEN="VERCEL_OIDC_TOKEN"

# GitHub OAuth (Development)
GITHUB_CLIENT_ID="GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="GITHUB_CLIENT_SECRET"

# Google OAuth
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

# Facebook OAuth
FACEBOOK_CLIENT_ID="FACEBOOK_CLIENT_ID"
FACEBOOK_CLIENT_SECRET="FACEBOOK_CLIENT_SECRET"

# Email (Resend) - used for magic links and password reset
RESEND_API_KEY="RESEND_API_KEY"
EMAIL_FROM="noreply@yourdomain.com"

BLOB_READ_WRITE_TOKEN="VERCEL_BLOB_READ_WRITE_TOKEN"
